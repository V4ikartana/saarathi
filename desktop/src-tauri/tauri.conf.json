{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Saarathi",
  "version": "0.1.0",
  "identifier": "io.github.v4ikartana.saarathi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Saarathi",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Many agents. One direction.",
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/saarathi"
    ],
    "publisher": "Vaikartana",
    "copyright": "Copyright \u00a9 2026 Vaikartana. Apache-2.0.",
    "longDescription": "Saarathi orchestrates Claude Code, Codex and Antigravity under one engineering lead: plans, isolated parallel work, verification and review.",
    "homepage": "https://github.com/V4ikartana/saarathi",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
